{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "pitman",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @pitman/frontend --filter @pitman/backend --parallel run dev",
		"build": "pnpm -r run build",
		"check": "pnpm -r run check",
		"test": "pnpm -r run test",
		"frontend": "pnpm --filter @pitman/frontend",
		"backend": "pnpm --filter @pitman/backend"
	},
	"engines": {
		"node": ">=22"
	}
}
