{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@pitman/wrsm",
	"version": "0.0.1",
	"private": true,
	"description": "Pure TypeScript rebuild of the WRSM/Pitman monthly rainfall-runoff model. No I/O, no DOM, no Node APIs.",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "25.6.0",
		"typescript": "6.0.2",
		"vitest": "5.0.4"
	}
}
