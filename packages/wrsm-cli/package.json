{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@pitman/wrsm-cli",
	"version": "0.0.1",
	"private": true,
	"description": "Command-line runner for @pitman/wrsm: reads a WRSM2000 network folder, runs it, compares against reference outputs.",
	"type": "module",
	"bin": {
		"wrsm": "./src/bin.ts"
	},
	"scripts": {
		"wrsm": "tsx src/bin.ts",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@pitman/wrsm": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.0.5",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
