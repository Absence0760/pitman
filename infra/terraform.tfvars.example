# Copy to infra/terraform.tfvars (gitignored) and fill in. Nothing here is a
# secret, but the IC-WBT bucket names embed IC-WBT's account ID, so they stay
# out of the public repo. Every variable is described in variables.tf.

# D-6. af-south-1 must be enabled in the account first. Any other region is
# refused unless data_outside_south_africa = true, which is allowed only with
# the privacy notice rewritten (A-AUTH-6).
aws_region = "af-south-1"
# data_outside_south_africa = false

# The delegated child zone the estate bootstrap created.
domain_name = "pitman.jaredhoward.com"

github_repo    = "Absence0760/pitman"
bootstrap_slug = "pitman"

# --- API Lambda --------------------------------------------------------------
lambda_memory_mb            = 1024 # 1024-2048, and x lambda_reserved_concurrency <= 10240
lambda_timeout_seconds      = 30
lambda_reserved_concurrency = 10 # 5-10 (>= 5 for the SQS triggers); needs the account's concurrency quota >= this + 11 (the breaker reserves 1)
lambda_log_retention_days   = 30

# --- IC-WBT's buckets (leave empty until Round 4.1's grants are merged) ------
# icwbt_region         = "af-south-1" # where IC-WBT's buckets are (DATA_REGION), not Pitman's region
# icwbt_account_id     = "<12-digit IC-WBT account ID>"
# chirps_bucket        = "water-management-mirror-<IC-WBT account ID>"
# chirps_prefix        = "rnl"
# chirps_root_metadata = false # the reader never opens the root zarr.json
# map_grid_bucket      = "water-management-reference-<IC-WBT account ID>"
# map_grid_key         = "reference/map-grid/<the WAAS file's key>"

# --- Sign-in mail (A-AUTH-7) ------------------------------------------------
# DMARC starts at none; tighten once the identity has sent cleanly for a while.
dmarc_policy = "none"
# dmarc_report_email = "you+pitman-dmarc@example.com"

# --- Edge and cost -------------------------------------------------------------
auth_waf_rate_limit_per_ip         = 100
waf_api_rate_limit_per_ip          = 300
waf_site_rate_limit_per_ip         = 2000
lambda_invocations_alarm_per_hour  = 2000
cloudfront_requests_alarm_per_hour = 20000 # edge requests per hour, checked per 5 minutes; nothing else bounds a spread flood
cloudfront_gb_alarm_per_hour       = 1     # edge egress per hour, checked per 5 minutes
route53_queries_alarm_per_hour     = 20000 # DNS queries on the zone per hour, checked per 5 minutes

# The spend breaker (breaker.tf): sets the API's reserved concurrency to 0.
# Reset with terraform apply once the cause is found.
breaker_concurrency_threshold = 6       # copies, 3 x 5 minutes in a row; 4 to lambda_reserved_concurrency
breaker_duration_ms_per_hour  = 7200000 # 2 copies busy the whole hour; x memory/1024 <= 7 200 000

# --- Cape Farm Mapper (D3) -----------------------------------------------------
# Never type the token here: decrypt it from infra-secrets into a gitignored
# *.auto.tfvars (docs/deployment.md § Lambda environment).
# cfm_crops_layer_url = "https://<the crops layer>/FeatureServer/<n>"
# cfm_dams_layer_url  = ""

# Must be above 0. Until "IAM access to billing information" is enabled in
# the account (docs/deployment.md § First deploy), set 0 AND the explicit
# opt-out below; turn it back off once billing access is on.
budget_monthly_usd = 25
# no_budget_acknowledged = true
# The daily budget: null derives ceil(25 x 2.25 / 30) = $2; 0 skips it.
# budget_daily_usd = 2
# Cost Anomaly Detection: off (0) for the first apply; then 5
# (docs/deployment.md § First deploy).
# cost_anomaly_threshold_usd = 5

# CloudFront's flat-rate plan: "none" (pay-as-you-go, the default) or "PRO"
# ($15 a month; created pending, unbilled, until you approve it in the
# console; raise budget_monthly_usd to 35 with it). docs/deployment.md
# § Then: the flat-rate plan.
# cloudfront_flat_rate_plan = "PRO"

# Both alert topics and the budgets email this address (confirm both SNS
# mails). Required, and refused on a reserved example domain, so this
# placeholder fails the plan until it is replaced with a real mailbox.
alert_email = "you+pitman-aws-alerts@example.com"
