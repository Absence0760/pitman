# Partial backend config: copy to infra/backend.config (gitignored), fill in,
# then `terraform -chdir=infra init -backend-config=backend.config`.
#
# The estate bootstrap creates the bucket as `<slug>-tfstate-<account-id>` in
# the region its projects/pitman.tfvars named (us-east-1 unless changed);
# its final summary prints the name.

bucket = "pitman-tfstate-<account-id>"
region = "us-east-1"
