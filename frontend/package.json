{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@pitman/frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vitest run",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@vitest/coverage-v8": "5.0.4",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
