{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@pitman/frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vitest run",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@pitman/wrsm": "workspace:*",
		"fflate": "0.8.3",
		"maplibre-gl": "6.16.0",
		"pmtiles": "4.5.0",
		"uplot": "1.6.32"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@vitest/coverage-v8": "5.0.5",
		"fake-indexeddb": "6.2.7",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
