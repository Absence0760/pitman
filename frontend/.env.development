# URL of the backend API, as the browser sees it. `/api` on the page's own
# origin, in dev as in prod: Vite's dev and preview servers proxy /api/* to the
# Hono dev server on :3001 with /api stripped (frontend/vite.config.ts), and in
# prod CloudFront proxies it to the Lambda Function URL with the shared secret
# (see infra/s3_cloudfront.tf). Same origin keeps the session cookie first-party.
PUBLIC_API_URL=/api

# Public URL of the site itself. Used for absolute URLs in Open Graph tags.
PUBLIC_SITE_URL=http://localhost:7777

# The map's tiles. Empty locally (local-first): the map draws on a plain background
# with everything else working. To see a basemap on a laptop, point these at PMTiles
# files in .env.development.local (docs/run-locally.md § The map). Same origin in production.
PUBLIC_TILES_URL=
PUBLIC_TILES_GLYPHS_URL=
PUBLIC_TERRAIN_URL=
