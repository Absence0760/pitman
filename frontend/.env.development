# URL of the backend API (must be reachable from the browser).
# In local development this is the Hono dev server.
# In prod this is `/api` — CloudFront proxies same-origin /api/* requests
# to the Lambda Function URL with the shared secret (see infra/s3_cloudfront.tf).
PUBLIC_API_URL=http://localhost:3001

# Public URL of the site itself. Used for absolute URLs in Open Graph tags.
PUBLIC_SITE_URL=http://localhost:7777

# The map's tiles. Empty locally (local-first): the map draws on a plain background
# with everything else working. To see a basemap on a laptop, point these at PMTiles
# files in .env.development.local (docs/run-locally.md § The map). Same origin in production.
PUBLIC_TILES_URL=
PUBLIC_TILES_GLYPHS_URL=
PUBLIC_TERRAIN_URL=
