{
	// SvelteKit 3 writes the base config to node_modules/$app/tsconfig.json
	// (allowJs, checkJs, moduleResolution "bundler", skipLibCheck…); it no longer supplies `include`,
	// so this file does. `#lib/…` resolves through package.json `imports`.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
