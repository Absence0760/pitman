#!/usr/bin/env bash
# Local gate while commits go straight to main (issue #22 steps 10-11): typecheck and test before any push.
# Skips when only docs/markdown changed. `pnpm install` points core.hooksPath at .githooks/
# (scripts/git-hooks/install.mjs), so there is nothing to copy (docs/run-locally.md).
set -euo pipefail
remote="$1"
zero=0000000000000000000000000000000000000000
code=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
  if git diff --name-only "$range" 2>/dev/null | grep -qvE '^(docs/|.*\.md$|\.claude/)'; then code=1; fi
done
[ "$code" = 0 ] && exit 0
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null
echo "pre-push: pnpm check && pnpm test" >&2
pnpm check >/dev/null 2>&1 && pnpm test >/dev/null 2>&1 || { echo "pre-push: check/test failed; not pushing" >&2; exit 1; }
