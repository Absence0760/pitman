#!/usr/bin/env bash
# Local gate before a push: `pnpm check && pnpm test`, so a broken branch fails here in a
# minute instead of in CI ten minutes later. `main` is protected and takes only pull requests
# whose "CI gate" passed (CLAUDE.md § Working alongside other Claude sessions), so this is the
# first look, not the gate. Skips when the pushed commits touch only docs/, *.md or .claude/
# (CI's `changes` job skips its heavy jobs on those too). A new branch is compared with where
# it left <remote>/main, not with the working tree. `pnpm install` points core.hooksPath at
# .githooks/ (scripts/git-hooks/install.mjs), so there is nothing to copy (docs/run-locally.md);
# scripts/git-hooks/pre-push.test.mjs pins what it runs.
set -euo pipefail
remote="${1:-origin}"
zero=0000000000000000000000000000000000000000
code=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue # deleting a remote branch
  base=""
  if [ "$rsha" != "$zero" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    base="$rsha"
  else
    # A new remote branch, or one whose old tip isn't here (rewritten): from where it left main.
    base=$(git merge-base "$lsha" "refs/remotes/$remote/main" 2>/dev/null || git merge-base "$lsha" refs/heads/main 2>/dev/null || true)
  fi
  if [ -z "$base" ]; then code=1; continue; fi # nothing to compare with: check
  files=$(git diff --name-only "$base" "$lsha")
  # A here-string, not a pipe: under pipefail, grep -q exiting early can SIGPIPE `git diff`.
  if [ -n "$files" ] && grep -qvE '^(docs/|.*\.md$|\.claude/)' <<<"$files"; then code=1; fi
done
[ "$code" = 0 ] && exit 0
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null
echo "pre-push: pnpm check && pnpm test" >&2
pnpm check >/dev/null 2>&1 && pnpm test >/dev/null 2>&1 || { echo "pre-push: check/test failed; not pushing" >&2; exit 1; }
