# Local-dev defaults for the backend. COMMITTED and loaded automatically by
# `pnpm dev` — a fresh clone runs with no setup. Non-sensitive values only
# (localhost URLs, ports, dev-only flags). Real production secrets live in the
# private infra-secrets repo (never here); machine-local real values go in a
# gitignored .env.development.local (loaded first, so it wins).

# Comma-separated list of origins allowed to call this API (CORS, csrf() and the same-origin check on
# every POST/PATCH/DELETE, src/http/sameOrigin.ts). The dev server (7777) and `vite preview` (8888, the
# end-to-end tests), on both names. In prod Terraform sets it to https://<domain_name>.
ALLOWED_ORIGINS=http://localhost:7777,http://127.0.0.1:7777,http://localhost:8888,http://127.0.0.1:8888

# Public URL of the site — used to build links in emails.
SITE_URL=http://localhost:7777

# Port for local dev server. It listens on 127.0.0.1 only; BACKEND_HOST overrides that (src/http/listen.ts).
PORT=3001

# Shared secret between CloudFront and the Lambda. In prod, Terraform
# generates a random value (random_password.cloudfront_shared_secret) and
# wires it both into the Lambda env AND the CloudFront origin custom_header,
# so every /api/* request CloudFront proxies carries the header. Direct
# hits to the Function URL fail the check.
#
# For local dev, LEAVE THIS EMPTY — the middleware skips the check when
# CLOUDFRONT_SHARED_SECRET is unset, which is correct because the dev
# frontend hits the dev backend directly (no CloudFront in the path).
CLOUDFRONT_SHARED_SECRET=

# --- Data API (docs/data.md, docs/run-locally.md § Backend data) ---
# Local-first: the dev server reads synthetic copies written by `pnpm dev:data:synthetic`
# (gitignored, backend/.local/). Invented values only; never real rain or MAP.
#
# CHIRPS copy: `local` reads a Zarr copy in CHIRPS_LOCAL_DIR; `s3` reads IC-WBT's mirror bucket
# (CHIRPS_BUCKET, CHIRPS_PREFIX default `rnl`, DATA_REGION default af-south-1), which needs the
# cross-account grant and AWS credentials — production only. Unset means not configured (a 503).
CHIRPS_SOURCE=local
CHIRPS_LOCAL_DIR=.local/mirror

# MAP grid: `local` reads MAP_GRID_LOCAL_FILE; `s3://bucket/key` reads that object (in DATA_REGION).
# MAP_GRID_DATASET names the grid in answers and the sidecar (default: the file name).
MAP_GRID_SOURCE=local
MAP_GRID_LOCAL_FILE=.local/map-grid/synthetic.json
MAP_GRID_DATASET=synthetic

# DEM (tributary delineation): `local` reads DEM_LOCAL_FILE, the invented terrain the same command writes;
# `s3://bucket/key` or `https://…` reads the production PMTiles archive with ranged requests (in DATA_REGION).
# Unset means not configured (a 503). DEM_LABEL overrides the name delineations carry.
DEM_SOURCE=local
DEM_LOCAL_FILE=.local/dem/synthetic.pmtiles

# Quaternary boundaries (GET /quaternaries): `local` reads QUATERNARIES_LOCAL_FILE, the committed
# synthetic region Z here. Unset means not configured (a 503), which is production until D-1 is settled:
# Pitman has no licensed boundaries (docs/data.md § Quaternaries). QUATERNARIES_CREDIT is what the
# screen and the sidecar credit them with (rule 8).
QUATERNARIES_SOURCE=local
QUATERNARIES_LOCAL_FILE=fixtures/geo/quaternaries.synthetic.geojson
QUATERNARIES_CREDIT="Synthetic test boundaries, invented for this repository (not DWS or WR2012)"

# Land use (POST /cfm/land-use): `local` answers from invented fields and dams in code, over the same block
# (nothing to generate). `cfm` reads the real layers through the proxy, which needs the operator's token in
# the Lambda's environment: never here, and never in a committed file (docs/data.md § Cape Farm Mapper, D3).
# Unset means not configured (a 503), which is production until the token exists.
CFM_SOURCE=local

# --- Sign-in (docs/run-locally.md § Sign-in, docs/architecture.md § Sign-in) ---
# Zero-docker default: auth-kit's in-memory user list (empty on every restart, so the dev server makes
# DEV_ADMIN_EMAIL the first admin at startup) and codes printed to this terminal instead of mailed.
# For DynamoDB Local and Mailpit instead (`pnpm dev:auth:up`, then `pnpm dev:auth:seed`), put these in
# backend/.env.development.local:
#   USER_STORE=dynamodb
#   USERS_TABLE=pitman-users-local
#   DYNAMODB_ENDPOINT=http://127.0.0.1:8000
#   MAIL_TRANSPORT=smtp
USER_STORE=memory
MAIL_TRANSPORT=console
# POST /auth/code puts the email on a queue (issue #30): here an in-process one that seals the message as
# the Lambda does and sends it just after the request answers. The Lambda uses SQS (MAIL_QUEUE=sqs).
MAIL_QUEUE=inline
MAIL_FROM="Pitman <no-reply@localhost>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
DEV_ADMIN_EMAIL=admin@example.test
# DEV-ONLY signing keys: they open nothing but a dev server on this machine. Production's are Terraform
# random_password values in the Lambda's environment (A-AUTH-8); never put a real one here.
AUTH_CODE_KEY=dev-only-code-key-not-a-secret-0123456789
AUTH_SESSION_KEY=dev-only-session-key-not-a-secret-0123456789
# http://localhost: a plain `pitman_session` cookie without Secure, for browsers that won't keep a Secure
# cookie over http. Refused on Lambda, which always uses __Host-pitman_session.
AUTH_DEV_COOKIE=true
