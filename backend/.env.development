# Local-dev defaults for the backend. COMMITTED and loaded automatically by
# `pnpm dev` — a fresh clone runs with no setup. Non-sensitive values only
# (localhost URLs, ports, dev-only flags). Real production secrets live in the
# private infra-secrets repo (never here); machine-local real values go in a
# gitignored .env.development.local (loaded first, so it wins).

# Comma-separated list of origins allowed to call this API.
# In prod, set this to your CloudFront domain (e.g. https://example.com).
ALLOWED_ORIGINS=http://localhost:7777

# Public URL of the site — used to build links in emails.
SITE_URL=http://localhost:7777

# Port for local dev server.
PORT=3001

# Shared secret between CloudFront and the Lambda. In prod, Terraform
# generates a random value (random_password.cloudfront_shared_secret) and
# wires it both into the Lambda env AND the CloudFront origin custom_header,
# so every /api/* request CloudFront proxies carries the header. Direct
# hits to the Function URL fail the check.
#
# For local dev, LEAVE THIS EMPTY — the middleware skips the check when
# CLOUDFRONT_SHARED_SECRET is unset, which is correct because the dev
# frontend hits the dev backend directly (no CloudFront in the path).
CLOUDFRONT_SHARED_SECRET=

# --- Data API (docs/data.md, docs/run-locally.md § Backend data) ---
# Local-first: the dev server reads synthetic copies written by `pnpm dev:data:synthetic`
# (gitignored, backend/.local/). Invented values only; never real rain or MAP.
#
# CHIRPS copy: `local` reads a Zarr copy in CHIRPS_LOCAL_DIR; `s3` reads IC-WBT's mirror bucket
# (CHIRPS_BUCKET, CHIRPS_PREFIX default `rnl`, DATA_REGION default af-south-1), which needs the
# cross-account grant and AWS credentials — production only. Unset means not configured (a 503).
CHIRPS_SOURCE=local
CHIRPS_LOCAL_DIR=.local/mirror

# MAP grid: `local` reads MAP_GRID_LOCAL_FILE; `s3://bucket/key` reads that object (in DATA_REGION).
# MAP_GRID_DATASET names the grid in answers and the sidecar (default: the file name).
MAP_GRID_SOURCE=local
MAP_GRID_LOCAL_FILE=.local/map-grid/synthetic.json
MAP_GRID_DATASET=synthetic

# DEM (tributary delineation): `local` reads DEM_LOCAL_FILE, the invented terrain the same command writes;
# `s3://bucket/key` or `https://…` reads the production PMTiles archive with ranged requests (in DATA_REGION).
# Unset means not configured (a 503). DEM_LABEL overrides the name delineations carry.
DEM_SOURCE=local
DEM_LOCAL_FILE=.local/dem/synthetic.pmtiles
