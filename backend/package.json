{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@pitman/backend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/lambda.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"start": "node dist/server.js"
	},
	"dependencies": {
		"dotenv": "^17.4.1",
		"hono": "4.13.14"
	},
	"devDependencies": {
		"@hono/node-server": "1.19.13",
		"@types/aws-lambda": "8.10.164",
		"@types/node": "25.6.0",
		"esbuild": "0.28.2",
		"tsx": "4.23.15",
		"typescript": "6.0.2",
		"vitest": "^2.1.9"
	}
}
