{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@pitman/backend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/lambda.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --passWithNoTests --coverage",
		"test:watch": "vitest",
		"start": "node dist/server.js"
	},
	"dependencies": {
		"@absence0760/auth-kit": "github:Absence0760/auth-kit#v0.2.0",
		"@aws-sdk/client-dynamodb": "3.1161.0",
		"@aws-sdk/client-s3": "3.1161.0",
		"@aws-sdk/client-sesv2": "3.1161.0",
		"@aws-sdk/lib-dynamodb": "3.1161.0",
		"@pitman/wrsm": "workspace:*",
		"@zarrita/storage": "0.2.0",
		"dotenv": "18.0.9",
		"hono": "4.13.16",
		"zarrita": "0.7.5"
	},
	"devDependencies": {
		"@aws-sdk/client-lambda": "3.1161.0",
		"@hono/node-server": "2.1.5",
		"@types/aws-lambda": "8.10.164",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.0.5",
		"esbuild": "0.28.2",
		"nodemailer": "10.3.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
